{
  "name": "tasks",
  "version": "0.2.1",
  "min_installer": "0.4.0",
  "description": "Compiles a task set using Beads from a given source or goal",
  "dependencies": [
    {
      "name": "Beads",
      "install_url": "https://github.com/gastownhall/beads/blob/main/docs/getting-started/installation.md",
      "detect": {
        "command": [
          "bd"
        ]
      }
    }
  ],
  "skill_files": [
    "SKILL.md"
  ],
  "harness_resources": {
    "codex": {
      "agents": [
        "agents/codex/tasks-designer.toml",
        "agents/codex/tasks-reviewer.toml"
      ]
    },
    "claude": {
      "agents": [
        "agents/claude/tasks-designer.md",
        "agents/claude/tasks-reviewer.md"
      ]
    }
  },
  "instruction_fragment": "AGENTS.md",
  "generated_cleanup": [
    {
      "kind": "beads-metadata",
      "description": "Beads tasks/issues generated from a goal/intent",
      "metadata_key": "jls-tasks",
      "metadata_value": "owned"
    }
  ],
  "generated_data": [
    {
      "path": ".jls/tasks",
      "marker": "project.json",
      "description": "Resumable Tasks design and review transaction checkpoints"
    }
  ]
}
